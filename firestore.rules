rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdministrator() {
      return signedIn()
        && request.auth.token.email == 'itzzamanverma@gmail.com'
        && request.auth.token.email_verified == true;
    }

    // Each signed-in account manages only its own planner.
    match /users/{userId} {
      allow read, create, update, delete: if signedIn()
        && request.auth.uid == userId;
    }

    // Shared starter planner is read-only to users; verified admin can manage it.
    match /appData/{documentId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdministrator();
    }
  }
}
