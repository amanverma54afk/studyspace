{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Studyspace: serve on localhost:8080",
      "type": "process",
      "command": "python",
      "args": [
        "-m",
        "http.server",
        "8080",
        "--bind",
        "127.0.0.1",
        "--directory",
        "${workspaceFolder}"
      ],
      "isBackground": true,
      "problemMatcher": {
        "owner": "custom",
        "pattern": {
          "regexp": "^(.+)$",
          "message": 1
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*",
          "endsPattern": "Serving HTTP on .* port 8080"
        }
      },
      "presentation": {
        "reveal": "always",
        "focus": false,
        "panel": "dedicated"
      }
    }
  ]
}
